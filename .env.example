# F5 SecureChat Enterprise - Environment Configuration
# Copy this file to '.env' and fill in your credentials from F5 AI Guardrails Console

# F5 AI Security Guardrails API Key (Generated in Project Settings -> API Keys)
F5_AI_GUARDRAILS_API_KEY="your_f5_guardrails_api_key_here"

# F5 AI Security Guardrails Project UUID
F5_AI_GUARDRAILS_PROJECT_ID="your_f5_guardrails_project_id_here"

# F5 AI Security Guardrails Base Portal URL (Default: https://www.us1.calypsoai.app)
# Change if using a different regional cluster or custom enterprise gateway
F5_AI_GUARDRAILS_BASE_URL="https://www.us1.calypsoai.app"

# Optional: Custom F5 Proxy Endpoint Override (Leave commented out for automatic provider resolution)
# F5_AI_GUARDRAILS_ENDPOINT="https://www.us1.calypsoai.app/openai/azure-open-ai/chat/completions"

# Application Server Port
PORT=8000
